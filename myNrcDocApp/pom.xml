<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Identita projektu v Maven repozitári a jeho názov. -->
    <groupId>sk.nrcdocapp</groupId>
    <artifactId>nrcdocapp</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>NrcDocApp</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Verzia JUnitu použitá pri spúšťaní automatických testov. -->
        <junit.version>5.12.1</junit.version>
    </properties>

    <dependencies>
        <!-- JavaFX ovládacie prvky, napríklad tlačidlá, popisky a tabuľky. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>27</version>
        </dependency>
        <!-- FXML načíta rozloženie okna zo samostatného XML súboru. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>27</version>
        </dependency>

        <!-- JUnit je pripravený na budúce testy; na bežné spustenie aplikácie nie je potrebný. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Kompiluje zdrojový kód pomocou JDK 27. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>27</source>
                    <target>27</target>
                </configuration>
            </plugin>
            <!-- Spúšťa JavaFX aplikáciu a pripravuje jej vlastný runtime obraz. -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <executions>
                    <execution>
                        <!-- Predvolená konfigurácia pre príkaz mvn clean javafx:run. -->
                        <id>default-cli</id>
                        <configuration>
                            <!-- Modul a hlavná JavaFX trieda, ktorá vytvorí okno. -->
                            <mainClass>sk.nrcdocapp/sk.nrcdocapp.NrcDocApp</mainClass>
                            <!-- Názov spúšťača a výstupného balíka pri neskoršom balení. -->
                            <launcher>nrcdocapp</launcher>
                            <jlinkZipName>nrcdocapp</jlinkZipName>
                            <jlinkImageName>nrcdocapp</jlinkImageName>
                            <noManPages>true</noManPages>
                            <stripDebug>true</stripDebug>
                            <noHeaderFiles>true</noHeaderFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Vytvorí Windows app-image s vlastným .exe spúšťačom a priloženým runtime. -->
            <plugin>
                <groupId>org.panteleyev</groupId>
                <artifactId>jpackage-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <!-- Použije runtime obraz vytvorený predchádzajúcim cieľom javafx:jlink. -->
                    <runtimeImage>${project.build.directory}/nrcdocapp</runtimeImage>
                    <module>sk.nrcdocapp/sk.nrcdocapp.NrcDocApp</module>
                    <name>NrcDocApp</name>
                    <appVersion>1.0.0</appVersion>
                    <vendor>NrcDocApp</vendor>
                    <type>APP_IMAGE</type>
                    <!-- Hotový balík ulož do priečinka target/dist. -->
                    <destination>${project.build.directory}/dist</destination>
                    <removeDestination>true</removeDestination>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
