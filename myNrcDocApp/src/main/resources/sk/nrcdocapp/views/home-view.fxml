<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Obsah úvodnej obrazovky; obrázok je pribalený ako zdroj aplikácie. -->
<VBox alignment="TOP_LEFT" spacing="14.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="sk.nrcdocapp.controller.HomeController" styleClass="page-content">
    <padding>
        <Insets top="36.0" right="44.0" bottom="36.0" left="44.0"/>
    </padding>
    <Label text="HOME" styleClass="page-title"/>
    <Label text="Vitajte v aplikácii NrcDocApp." styleClass="page-description" wrapText="true"/>
    <HBox alignment="CENTER" VBox.vgrow="ALWAYS">
        <ImageView fitWidth="760.0" fitHeight="430.0" preserveRatio="true" smooth="true"
                   accessibleText="Obrázok na úvodnej obrazovke">
            <image>
                <Image url="@../images/homeImage.jpg"/>
            </image>
        </ImageView>
    </HBox>
</VBox>
